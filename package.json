{
	"name": "html-vision",
	"version": "1.0.5",
	"description": "A set of utility functions for html",
	"type": "module",
	"exports": {
		".": {
			"import": "./lib/index.js",
			"types": "./lib/index.d.ts"
		},
		"./queries.js": {
			"import": "./lib/queries.js",
			"types": "./lib/queries.d.ts"
		},
		"./click.js": {
			"import": "./lib/click.js",
			"types": "./lib/click.d.ts"
		},
		"./ss.js": {
			"import": "./lib/ss.js",
			"types": "./lib/ss.d.ts"
		},
		"./getActiveElement.js": {
			"import": "./lib/getActiveElement.js",
			"types": "./lib/getActiveElement.d.ts"
		},
		"./visibility.js": {
			"import": "./lib/visibility.js",
			"types": "./lib/visibility.d.ts"
		},
		"./scroll.js": {
			"import": "./lib/scroll.js",
			"types": "./lib/scroll.d.ts"
		},
		"./highlight.js": {
			"import": "./lib/highlight.js",
			"types": "./lib/highlight.d.ts"
		},
		"./tabbing.js": {
			"import": "./lib/tabbing.js",
			"types": "./lib/tabbing.d.ts"
		}
	},
	"scripts": {
		"build": "wireit"
	},
	"wireit": {
		"build": {
			"command": "tsc --pretty",
			"clean": "if-file-deleted",
			"files": [
				"./src",
				"./tsconfig.json"
			],
			"output": [
				"lib"
			]
		}
	},
	"files": [
		"./lib/**/*.js",
		"./lib/**/*.d.ts"
	],
	"devDependencies": {
		"@vdegenne/mini-gamepad": "^0.4.17",
		"tslib": "^2.8.1",
		"typescript": "^7.0.2",
		"vite": "^8.2.0",
		"wireit": "^0.14.13",
		"lit": "^3.0.0"
	},
	"dependencies": {
		"@vdegenne/debouncer": "^1.0.17"
	},
	"peerDependencies": {
		"lit": "^3.0.0"
	}
}
